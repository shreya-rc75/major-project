# PostgreSQL Database Configuration
# For local development with SQLite: sqlite:///./dev.db
# For PostgreSQL: postgresql://user:password@localhost:5432/cervicare_db
DATABASE_URL=postgresql://user:password@localhost:5432/cervicare_db

# JWT & Security (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your-very-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Model Path
MODEL_PATH=./models/efficientnet_b3_best.pth

# File Upload Directory
UPLOAD_DIR=./uploads

# CORS Configuration (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Environment
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
