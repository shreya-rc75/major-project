<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>CerviCare — Analysis Report</title>
  <style>
    /* Print-friendly styles */
    @page { size: A4; margin: 20mm; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; color: #222; margin: 0; padding: 0; }
    .container { max-width: 800px; margin: 0 auto; padding: 10px 20px; }
    header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
    .logo { display: flex; align-items: center; }
    .logo img { width: 120px; height: auto; object-fit: contain; }
    .project-title { font-size: 18px; font-weight: 700; color: #0b4f6c; }
    h1 { font-size: 20px; margin: 8px 0 16px 0; }
    .section { border-top: 1px solid #e6e6e6; padding-top: 12px; margin-top: 12px; }
    .row { display: flex; width: 100%; gap: 12px; }
    .col { flex: 1; }

    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 6px 8px; vertical-align: top; }
    th { width: 180px; color: #444; font-weight: 600; }

    .image-box { border: 1px solid #ddd; padding: 8px; text-align: center; background: #fafafa; }
    .image-box img { max-width: 100%; height: auto; display: block; margin: 0 auto; }

    .badge { display:inline-block; padding:4px 8px; border-radius:4px; color:#fff; font-weight:600 }
    .badge-low { background:#2e7d32 }
    .badge-medium { background:#f9a825 }
    .badge-high { background:#c62828 }

    .muted { color:#666; font-size:12px }
    .explanation { white-space: pre-wrap; font-size: 13px; color:#333 }

    footer { margin-top: 20px; padding-top: 10px; border-top: 1px dashed #e6e6e6; font-size: 12px; color: #666; display:flex; justify-content:space-between }

    /* Responsive for narrow widths when previewing */
    @media (max-width: 600px) {
      .row { flex-direction: column; }
      th { width: 140px; }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="logo">
        <!-- Placeholder logo: replace with actual image in production -->
        <div style="width:120px;height:48px;background:#e6f2f7;color:#0b4f6c;display:flex;align-items:center;justify-content:center;font-weight:700;border-radius:4px">CerviCare</div>
      </div>
      <div style="text-align:right">
        <div class="project-title">Cervical Cancer Detection System</div>
        <div class="muted">Automated Analysis Report</div>
      </div>
    </header>

    <h1>Analysis Report</h1>

    <section class="section">
      <h2>Patient Information</h2>
      <table>
        <tr><th>Name</th><td>{{ patient.full_name or 'Not Available' }}</td></tr>
        <tr><th>Patient ID</th><td>{{ patient.patient_identifier or 'Not Available' }}</td></tr>
        <tr><th>Age</th><td>{% if patient.date_of_birth %}{{ ((data_date or '') and ((data_date|default('')|string)) ) }}{% endif %}{{ 'Not Provided' if not patient.date_of_birth else '' }}</td></tr>
        <tr><th>Gender</th><td>{{ patient.gender or 'Not Available' }}</td></tr>
      </table>
    </section>

    <section class="section">
      <h2>Study Information</h2>
      <table>
        <tr><th>Study ID</th><td>{{ study.accession or study.id }}</td></tr>
        <tr><th>Date</th><td>{{ study.study_date or 'Not Available' }}</td></tr>
      </table>
    </section>

    <section class="section">
      <h2>Uploaded Image</h2>
      <div class="row">
        <div class="col image-box">
          {% if image.url %}
            <img src="{{ image.url }}" alt="Uploaded Pap smear">
          {% else %}
            <div class="muted">Uploaded image not available</div>
          {% endif %}
          <div class="muted">Filename: {{ image.filename or 'N/A' }}</div>
        </div>
        <div class="col">
          <h3>AI Analysis Results</h3>
          <table>
            <tr><th>Predicted Class</th><td>{{ analysis.predicted_class or 'Not Available' }}</td></tr>
            <tr><th>Confidence</th><td>{% if analysis.probabilities %}
              {% set top = analysis.probabilities|dictsort(false, 'value')|reverse|first %}
              {{ (top[1] * 100)|round(2) }}% ({{ top[0] }})
              {% else %}Not Available{% endif %}
            </td></tr>
            <tr><th>Analysis Status</th><td>{{ analysis.status or 'Not Available' }}</td></tr>
            <tr><th>Timestamp</th><td>{{ analysis.created_at or 'Not Available' }}</td></tr>
          </table>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>Clinical Stage Prediction</h2>
      {% if stage_prediction %}
        <table>
          <tr><th>Stage</th><td>{{ stage_prediction.stage }}</td></tr>
          <tr><th>Confidence</th><td>{{ stage_prediction.confidence or 'Not Available' }}</td></tr>
          <tr><th>Explanation</th><td class="explanation">{{ stage_prediction.explanation or 'Not Available' }}</td></tr>
        </table>
      {% else %}
        <div class="muted">Stage prediction not available.</div>
      {% endif %}
    </section>

    <section class="section">
      <h2>Future Risk Assessment</h2>
      {% if risk_analysis %}
        <table>
          <tr><th>1-Year Risk</th><td>{{ (risk_analysis.risk_1y * 100)|round(2) }}% </td></tr>
          <tr><th>3-Year Risk</th><td>{{ (risk_analysis.risk_3y * 100)|round(2) }}% </td></tr>
          <tr><th>5-Year Risk</th><td>{{ (risk_analysis.risk_5y * 100)|round(2) }}% </td></tr>
          <tr><th>Overall Risk Level</th><td>
            {% if risk_analysis.risk_category == 'low' %}
              <span class="badge badge-low">Low</span>
            {% elif risk_analysis.risk_category == 'medium' %}
              <span class="badge badge-medium">Medium</span>
            {% elif risk_analysis.risk_category == 'high' %}
              <span class="badge badge-high">High</span>
            {% else %}
              {{ risk_analysis.risk_category or 'Not Available' }}
            {% endif %}
          </td></tr>
          <tr><th>Recommendations</th><td>
            {% if risk_analysis.recommendations %}
              <ul>
              {% for r in risk_analysis.recommendations %}
                <li>{{ r }}</li>
              {% endfor %}
              </ul>
            {% else %}
              Not Available
            {% endif %}
          </td></tr>
        </table>
      {% else %}
        <div class="muted">Risk analysis not available.</div>
      {% endif %}
    </section>

    <section class="section">
      <h2>Grad-CAM Visualization</h2>
      <div class="image-box">
        {% if media.gradcam_url %}
          <img src="{{ media.gradcam_url }}" alt="Grad-CAM">
        {% else %}
          <div class="muted">Grad-CAM visualization not available.</div>
        {% endif %}
      </div>
    </section>

    <section class="section">
      <h2>Analysis Notes & Disclaimer</h2>
      <p class="muted">This report was generated by an AI assisted Cervical Cancer Detection System. The clinical stage and risk predictions are algorithmic estimates and are intended for decision support only. They do not replace professional clinical judgment. Final diagnosis, staging and treatment decisions must be made by qualified clinicians.</p>
    </section>

    <footer>
      <div>Generated by CerviCare</div>
      <div class="muted">Report generated: {{ generation_time or 'Not Available' }}</div>
    </footer>
  </div>
</body>
</html>
